# ─────────────────────────────────────────────────────────────────
# FocusOura — Environment Variables
# Copy this file to .env and fill in the values before running.
# ─────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────
# PostgreSQL connection URL (used by Drizzle ORM in api-server)
DATABASE_URL=postgresql://focusoura:focusoura@localhost:5432/focusoura

# ── Auth ─────────────────────────────────────────────────────────
# Secret used to sign JWT tokens. REQUIRED — server will refuse to start if missing.
# Must be at least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=your-secure-random-secret-here

# ── Google / Firebase ─────────────────────────────────────────────
# Firebase project settings (used for Google OAuth on the backend)
FIREBASE_PROJECT_ID=focusoura-99dae

# Google API key for Gemini AI (motivational messages)
GOOGLE_API_KEY=your_google_api_key_here

# ── Frontend (Vite) ───────────────────────────────────────────────
# These are exposed to the browser. Prefix MUST be VITE_
VITE_FIREBASE_PROJECT_ID=focusoura-99dae
VITE_FIREBASE_AUTH_DOMAIN=focusoura-99dae.firebaseapp.com

# ── Email (Resend) ────────────────────────────────────────────────
# Required for password-reset emails. Get a key at https://resend.com
# If not set, emails are skipped (a warning is logged) — safe for local dev.
RESEND_API_KEY=re_your_resend_api_key_here

# ── Frontend URL ──────────────────────────────────────────────────
# Base URL of the web app — used to build the reset-password link in emails.
# Defaults to http://localhost:22334 if not set.
FRONTEND_URL=http://localhost:22334

# ── Server Ports ──────────────────────────────────────────────────
# API server port
PORT=8080

# Vite dev server port
# PORT=22333  (set this in the web start command)
