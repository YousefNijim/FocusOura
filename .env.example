# ─────────────────────────────────────────────────────────────────
# FocusOura — Environment Variables
# Copy this file to .env and fill in the values before running.
# ─────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────
# PostgreSQL connection URL (used by Drizzle ORM in api-server)
DATABASE_URL=postgresql://focusoura:focusoura@localhost:5432/focusoura

# ── Auth ─────────────────────────────────────────────────────────
# Secret used to sign JWT tokens. REQUIRED — server will refuse to start if missing.
# Must be at least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=your-secure-random-secret-here

# ── Google / Firebase ─────────────────────────────────────────────
# Firebase project settings (used for Google OAuth on the backend)
FIREBASE_PROJECT_ID=focusoura-99dae

# Google API key for Gemini AI (motivational messages)
GOOGLE_API_KEY=your_google_api_key_here

# ── Frontend (Vite) ───────────────────────────────────────────────
# These are exposed to the browser. Prefix MUST be VITE_
VITE_FIREBASE_PROJECT_ID=focusoura-99dae
VITE_FIREBASE_AUTH_DOMAIN=focusoura-99dae.firebaseapp.com

# REQUIRED on Vercel — must point to the Railway API URL.
# Without this, all API calls hit Vercel (404/405) and login/register fail.
# Example: https://focusoura-api-xxxx.up.railway.app
VITE_API_BASE_URL=https://your-api.up.railway.app

# ── Email (Resend) ────────────────────────────────────────────────
# Required for password-reset emails. Get a key at https://resend.com
# If not set, emails are skipped (a warning is logged) — safe for local dev.
RESEND_API_KEY=re_your_resend_api_key_here

# ── Frontend / CORS URLs ─────────────────────────────────────────
# Base URL of the web app — used to build the reset-password + verification
# email links. REQUIRED on Railway, otherwise links point to localhost.
# Production: set to your Vercel URL.
FRONTEND_URL=https://focusoura.vercel.app

# REQUIRED on Railway — whitelisted in CORS config.
# Set to your Vercel production URL.
WEB_URL=https://focusoura.vercel.app

# Optional — allows Vercel preview deployments to call the API.
# Value must be the wildcard pattern, e.g.: https://*.vercel.app
WEB_URL_PREVIEW=https://*.vercel.app

# Base URL for generating shareable friend invite links (server-side).
# Set to your web app URL in production (same as WEB_URL / FRONTEND_URL).
APP_URL=https://focusoura.vercel.app

# ── Server Ports ──────────────────────────────────────────────────
# API server port
PORT=8080

# Vite dev server port
# PORT=22333  (set this in the web start command)
