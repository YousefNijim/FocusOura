# FocusOura — Android APK Build Environment
# This file is used when building the Android APK.
# Replace the IP with your actual PC's WiFi IP address.

# Your PC's WiFi IP (found via: ipconfig | findstr IPv4)
VITE_API_BASE_URL=http://192.168.157.1:8080

# Port and base path for Vite build
PORT=22333
BASE_PATH=/
